<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs-export-doc-check" targetNamespace="https://rawkeep.de/process-modeling"><bpmn:process id="proc-export-doc-check" name="Exportdokumente prüfen &amp; freigeben" isExecutable="false"><bpmn:documentation>[Export &amp; Logistik] Handelsdokument (Proforma/Packliste/B/L) eingangsprüfen: Extraktion, Stammdaten-Abgleich, Trade-Compliance, Risiko-Entscheidung, HITL-Freigabe.</bpmn:documentation><bpmn:startEvent id="start" name="Dokument eingegangen"><bpmn:documentation>Vertrieb</bpmn:documentation></bpmn:startEvent><bpmn:serviceTask id="extract" name="Daten extrahieren (Skill 1)"><bpmn:documentation>SAP Joule</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="master" name="Stammdaten abgleichen (Skill 2)"><bpmn:documentation>SAP S/4HANA</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="comply" name="Trade-Compliance prüfen (Skill 3)"><bpmn:documentation>SAP Joule</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="risk" name="Risiko bewerten (Skill 4)"><bpmn:documentation>Decision Engine</bpmn:documentation></bpmn:serviceTask><bpmn:exclusiveGateway id="d-risk" name="Risiko-Score?"><bpmn:documentation>Compliance</bpmn:documentation></bpmn:exclusiveGateway><bpmn:userTask id="review" name="Manuelle Prüfung"><bpmn:documentation>Exportleitung</bpmn:documentation></bpmn:userTask><bpmn:exclusiveGateway id="d-review" name="Freigabe erteilt?"><bpmn:documentation>Exportleitung</bpmn:documentation></bpmn:exclusiveGateway><bpmn:serviceTask id="case" name="Vorgang anlegen &amp; freigeben (Skill 5)"><bpmn:documentation>SAP S/4HANA</bpmn:documentation></bpmn:serviceTask><bpmn:userTask id="reject" name="Dokument zurückweisen"><bpmn:documentation>Vertrieb</bpmn:documentation></bpmn:userTask><bpmn:endEvent id="end" name="Prozess abgeschlossen" /><bpmn:sequenceFlow id="flow-0" sourceRef="start" targetRef="extract" /><bpmn:sequenceFlow id="flow-1" sourceRef="extract" targetRef="master" /><bpmn:sequenceFlow id="flow-2" sourceRef="master" targetRef="comply" /><bpmn:sequenceFlow id="flow-3" sourceRef="comply" targetRef="risk" /><bpmn:sequenceFlow id="flow-4" sourceRef="risk" targetRef="d-risk" /><bpmn:sequenceFlow id="flow-5" sourceRef="d-risk" targetRef="case" name="AUTO_APPROVE" /><bpmn:sequenceFlow id="flow-6" sourceRef="d-risk" targetRef="review" name="REVIEW_REQUIRED" /><bpmn:sequenceFlow id="flow-7" sourceRef="review" targetRef="d-review" /><bpmn:sequenceFlow id="flow-8" sourceRef="d-review" targetRef="case" name="ja" /><bpmn:sequenceFlow id="flow-9" sourceRef="d-review" targetRef="reject" name="nein" /><bpmn:sequenceFlow id="flow-10" sourceRef="case" targetRef="end" /><bpmn:sequenceFlow id="flow-11" sourceRef="reject" targetRef="end" /></bpmn:process><bpmndi:BPMNDiagram id="dia-export-doc-check"><bpmndi:BPMNPlane id="plane-export-doc-check" bpmnElement="proc-export-doc-check"><bpmndi:BPMNShape id="shape-start" bpmnElement="start"><dc:Bounds x="40" y="300" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-extract" bpmnElement="extract"><dc:Bounds x="320" y="300" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-master" bpmnElement="master"><dc:Bounds x="600" y="300" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-comply" bpmnElement="comply"><dc:Bounds x="880" y="300" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-risk" bpmnElement="risk"><dc:Bounds x="1160" y="300" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-d-risk" bpmnElement="d-risk"><dc:Bounds x="1440" y="300" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-review" bpmnElement="review"><dc:Bounds x="1720" y="300" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-d-review" bpmnElement="d-review"><dc:Bounds x="2000" y="300" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-case" bpmnElement="case"><dc:Bounds x="1720" y="500" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-reject" bpmnElement="reject"><dc:Bounds x="2280" y="300" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape-end" bpmnElement="end"><dc:Bounds x="2000" y="500" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="edge-flow-0" bpmnElement="flow-0"><di:waypoint x="58.0" y="318.0" /><di:waypoint x="370.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-1" bpmnElement="flow-1"><di:waypoint x="370.0" y="340.0" /><di:waypoint x="650.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-2" bpmnElement="flow-2"><di:waypoint x="650.0" y="340.0" /><di:waypoint x="930.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-3" bpmnElement="flow-3"><di:waypoint x="930.0" y="340.0" /><di:waypoint x="1210.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-4" bpmnElement="flow-4"><di:waypoint x="1210.0" y="340.0" /><di:waypoint x="1465.0" y="325.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-5" bpmnElement="flow-5"><di:waypoint x="1465.0" y="325.0" /><di:waypoint x="1770.0" y="540.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-6" bpmnElement="flow-6"><di:waypoint x="1465.0" y="325.0" /><di:waypoint x="1770.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-7" bpmnElement="flow-7"><di:waypoint x="1770.0" y="340.0" /><di:waypoint x="2025.0" y="325.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-8" bpmnElement="flow-8"><di:waypoint x="2025.0" y="325.0" /><di:waypoint x="1770.0" y="540.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-9" bpmnElement="flow-9"><di:waypoint x="2025.0" y="325.0" /><di:waypoint x="2330.0" y="340.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge-flow-10" bpmnElement="flow-10"><di:waypoint x="177